#!/usr/bin/env python3
"""Run the installed raven-listen, save its full card as usual, print slim.

Also accepts a saved .txt card directly (read-only). --full prints the
launcher's card with legacy private prompt previews removed.
Other song options pass through to raven-listen.
RAVEN_LISTEN may name an alternate launcher; RAVEN_SLIM_PYTHON an interpreter
with numpy for the optional ache analysis. No engines are imported here.
"""
from pathlib import Path
import os
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
import slim
from stage_status import names_note_bytes
from network_policy import offline


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("--help", "-h"):
        print(__doc__)
        print('usage: raven-listen-slim SONG_OR_CARD [--full] [raven-listen options]')
        return 0 if args else 2
    full = "--full" in args
    args = [a for a in args if a != "--full"]
    if not args:
        print(slim.INVITATION)
        return 2
    source = Path(args[0]).expanduser()
    if source.suffix.lower() == ".txt":
        if full:
            if len(args) != 1:
                print("raven-listen-slim: --full with a saved card accepts no extra options", file=sys.stderr)
                print(slim.INVITATION)
                return 2
            try:
                sys.stdout.buffer.write(names_note_bytes(source.read_bytes()))
            except OSError as e:
                print(f"DIDN'T HEAR: full card unavailable ({e})")
                print(slim.INVITATION)
                return 1
            return 0
        # Delegate JSON loading/ache to the main repo's venv when available.
        candidates = [ROOT / "venv/bin/python"]
        python = os.environ.get("RAVEN_SLIM_PYTHON") or next((str(p) for p in candidates if p.is_file()), sys.executable)
        return subprocess.call([python, str(ROOT / "slim.py"), str(source), *args[1:]])
    if offline():
        print("external launcher disabled by RAVEN_EARS_OFFLINE=1; pass a saved card")
        print(slim.INVITATION)
        return 2
    launcher = os.environ.get("RAVEN_LISTEN", "raven-listen")
    try:
        result = subprocess.run([launcher, *args], capture_output=True)
    except OSError as e:
        print(f"DIDN'T HEAR: raven-listen unavailable ({e})")
        print(slim.INVITATION)
        return 1
    sys.stderr.buffer.write(names_note_bytes(result.stderr))
    if full:
        sys.stdout.buffer.write(names_note_bytes(result.stdout))
        return result.returncode
    if result.returncode:
        print(f"DIDN'T HEAR: raven-listen failed (exit {result.returncode}); no completed card")
        print(slim.INVITATION)
        return result.returncode
    # The existing launcher announces the exact saved path on stderr. Using it
    # avoids guessing a title/path and never opens the saved card for writing.
    saved = re.findall(r"^\(card saved: (.*)\)$", result.stderr.decode("utf-8", errors="replace"), re.M)
    sys.stdout.write(slim.render(result.stdout.decode("utf-8", errors="replace"), saved[-1] if saved else None))
    return 0


if __name__ == "__main__":
    sys.exit(main())
